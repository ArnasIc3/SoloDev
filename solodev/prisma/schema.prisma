generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Task {
  id          Int      @id @default(autoincrement())
  taskId      String   @unique
  title       String
  description String?
  status      String   @default("To Do")
  priority    String   @default("Medium")
  assignee    String   @default("AR")
  storyPoints Int      @default(1)
  sprintId    Int?
  sprint      Sprint?  @relation(fields: [sprintId], references: [id])
  aiOutput    String?
  userId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Sprint {
  id        Int       @id @default(autoincrement())
  name      String
  shortName String
  goal      String?
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("planned")
  tasks     Task[]
  userId    String?
  createdAt DateTime  @default(now())
}

model TeamMember {
  id       String  @id
  initials String
  name     String
  role     String
  isAI     Boolean @default(false)
  color    String
}

model Meeting {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  taskId      String?
  taskTitle   String?
  sprintName  String?
  messages    String
  userId      String?
  createdAt   DateTime @default(now())
}

model ProjectSettings {
  id          Int      @id @default(autoincrement())
  name        String   @default("My Project")
  techStack   String   @default("")
  domain      String   @default("")
  description String   @default("")
  userId      String?  @unique
  updatedAt   DateTime @updatedAt
}
